+test "coefficient validation rejects non-canonical words at every lane and tail position" {
+    // A clean column is accepted whatever its length, so a short column still
+    // exercises the scalar tail and a long one the vector body.
+    for ([_]usize{ 1, 2, 7, 8, 9, 15, 16, 17, 64, 129 }) |len| {
+        const values = try std.testing.allocator.alloc(u32, len);
+        defer std.testing.allocator.free(values);
+        @memset(values, 0);
+        values[len - 1] = 0x7fff_fffe;
+        try validateCanonicalCoefficients(values);
+
+        // Every position must reject, including the ones that only reach the
+        // scalar tail and the last lane of a partial vector.
+        for (0..len) |at| {
+            @memset(values, 0);
+            values[at] = 0x7fff_ffff;
+            try std.testing.expectError(
+                error.NonCanonicalPreprocessedCoefficient,
+                validateCanonicalCoefficients(values),
+            );
+            values[at] = 0x8000_0000;
+            try std.testing.expectError(
+                error.NonCanonicalPreprocessedCoefficient,
+                validateCanonicalCoefficients(values),
+            );
+            @memset(values, 0);
+        }
+    }
+}
