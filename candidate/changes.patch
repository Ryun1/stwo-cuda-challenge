+/// Reject a coefficient column that is not entirely canonical field elements.
+///
+/// The predicate is unchanged: some `value >= 0x7fff_ffff` exists if and only
+/// if `max(values) >= 0x7fff_ffff`, so folding a maximum is equivalent to the
+/// per-word scan and still raises the same error for the same column.
+///
+/// The pinned form tested each word in a scalar loop whose body could exit.
+/// That early return is what stops LLVM from widening the loop, so the column
+/// streamed one `u32` per iteration. A branch-free maximum over `@Vector(8,
+/// u32)` lanes is a pure elementwise `max` the backend can vectorize, and it
+/// needs no early exit to be correct. The measured STWZPPC artifact carries
+/// 543,101,879 coefficients (2.02 GiB), so this pass runs once per proof on
+/// every case in the basket.
+fn validateCanonicalCoefficients(values: []const u32) !void {
+    const lane_count = 8;
+    const Lanes = @Vector(lane_count, u32);
+    var lanes: Lanes = @splat(0);
+    var index: usize = 0;
+    const body = values.len - values.len % lane_count;
+    while (index < body) : (index += lane_count) {
+        const chunk: Lanes = @as(*const [lane_count]u32, @ptrCast(values.ptr + index)).*;
+        lanes = @max(lanes, chunk);
+    }
+    var tail: u32 = 0;
+    while (index < values.len) : (index += 1) {
+        tail = @max(tail, values[index]);
+    }
+    if (@reduce(.Max, lanes) >= 0x7fff_ffff or tail >= 0x7fff_ffff)
+        return error.NonCanonicalPreprocessedCoefficient;
+}
